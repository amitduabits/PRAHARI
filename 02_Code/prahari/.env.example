# Copy to .env. Never commit .env.

APP_HOST=127.0.0.1
APP_PORT=8080
JUDGE_USER=judge
JUDGE_PASSWORD=set-this-before-submit
ADMIN_USER=admin
ADMIN_PASSWORD=admin
VIEWER_HOME=home.viewer
VIEWER_PASSWORD=viewer
AUDITOR_USER=auditor
AUDITOR_PASSWORD=auditor
SECRET_KEY=change-me
MAX_OPEN_CAPTURES=4
ANPR_ENGINE=tesseract
ANALYTICS_ENGINES=anpr,objects
OBJECT_ENGINE=opencv
FACE_DIR=data/faces

# Leave empty until Resources login yields a host. Platform must boot without it.
SENTINEL_HOST=
SENTINEL_CATALOGUE_PATH=/cameras.json
SENTINEL_PASSWORD=
SENTINEL_RTSP_HOST=

# Capture
RTSP_TRANSPORT=tcp
RECONNECT_MIN_S=2
RECONNECT_MAX_S=30
SAMPLE_FPS=1
ANPR_MIN_CONFIDENCE=0.35

# Paths
DB_PATH=data/prahari.db
CROP_DIR=data/crops
