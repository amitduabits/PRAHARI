%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% bitsbrand.sty -- Yushu Excellence Technologies Pvt. Ltd. identity
%% PRAHARI stakeholder slides and notes
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bitsbrand}[2026/09/04 v1.1 Yushu Excellence branding for PRAHARI]

\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{tikz}

%%--------------------------------------------------------------------------
%% 1. Institutional palette (Yushu monochrome + ink)
%%--------------------------------------------------------------------------
\definecolor{bitsblue}{HTML}{111111}   % wordmark ink
\definecolor{bitsgold}{HTML}{4A4A4A}   % brand bar, segment 1
\definecolor{bitssky}{HTML}{6B6B6B}    % brand bar, segment 2
\definecolor{bitsred}{HTML}{111111}    % brand bar, segment 3

%%--------------------------------------------------------------------------
%% 2. Semantic palette (Master Spec section 3.3)
%% Colour carries meaning. Do not use these decoratively.
%%--------------------------------------------------------------------------
\definecolor{okgreen}{HTML}{1B7F4B}    % holds / correct / compiles
\definecolor{errred}{HTML}{A61B29}     % fails / undefined / gotcha
\definecolor{codebg}{HTML}{F5F5F2}     % listing background
\definecolor{mutedgrey}{HTML}{5A5A5A}  % de-emphasised text
\definecolor{rulegrey}{HTML}{D8D8D4}   % hairlines

% Aliases so authors never guess
\colorlet{bitsaccent}{bitsgold}
\colorlet{bitsprimary}{bitsblue}

%%--------------------------------------------------------------------------
%% 3. Logo handling
%% pdflatex chokes on some alpha PNGs. logo-yushu.png is pre-flattened RGB.
%%--------------------------------------------------------------------------
\IfFileExists{logo-yushu.pdf}{\def\bits@logofile{logo-yushu.pdf}}{%
  \IfFileExists{logo-yushu.png}{\def\bits@logofile{logo-yushu.png}}{%
    \def\bits@logofile{}}}

% \bitslogo[<height>] -- default 2.2cm
\newcommand{\bitslogo}[1][2.2cm]{%
  \ifx\bits@logofile\@empty
    \textcolor{errred}{\framebox{\rule{0pt}{#1}\ LOGO MISSING\ }}%
  \else
    \includegraphics[height=#1]{\bits@logofile}%
  \fi}

%%--------------------------------------------------------------------------
%% 4. Brand rule bar
%% Drawn in TikZ rather than included as a bitmap so it scales cleanly and
%% carries no resolution penalty. Single-ink bar for the Yushu wordmark.
%%--------------------------------------------------------------------------
% \bitsbar[<width>][<thickness>]
\newcommand{\bitsbar}[2][\linewidth]{%
  \begingroup
  \setlength{\unitlength}{1pt}%
  \begin{tikzpicture}[x=1pt,y=1pt]
    \pgfmathsetmacro{\bw}{\the\dimexpr#1\relax/1pt}
    \pgfmathsetmacro{\bt}{\the\dimexpr#2\relax/1pt}
    \fill[bitsgold] (0,0)             rectangle (0.32*\bw,\bt);
    \fill[bitssky]  (0.32*\bw,0)      rectangle (0.72*\bw,\bt);
    \fill[bitsred]  (0.72*\bw,0)      rectangle (\bw,\bt);
  \end{tikzpicture}%
  \endgroup}

\newcommand{\bitsbardefault}{\bitsbar[\linewidth]{2.2pt}}

%%--------------------------------------------------------------------------
%% 5. Institutional name blocks
%% Exact strings. Never retype these inline; always call the macro, so a
%% future rename propagates through every deck and every set of notes.
%%--------------------------------------------------------------------------
\newcommand{\bitsname}{Yushu Excellence Technologies Pvt.\ Ltd.}
\newcommand{\bitscampus}{yushuexcellence.in}
\newcommand{\bitsdivision}{PRAHARI}
\newcommand{\bitssemester}{2026}

\newcommand{\coursecode}{PRAHARI}
\newcommand{\coursetitle}{Statewide CCTV intelligence plane}

% Stacked identity block, used on title pages
\newcommand{\bitsidentity}{%
  \begingroup
  \color{bitsblue}\sffamily
  {\large\bfseries \bitsname}\\[0.15em]
  {\normalsize \bitscampus}\\[0.15em]
  {\normalsize\bfseries \bitsdivision}%
  \endgroup}

\endinput
